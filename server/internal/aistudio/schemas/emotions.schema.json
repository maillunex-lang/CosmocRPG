          },
          "decay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "id",
          "triggers",
          "decay"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 50
