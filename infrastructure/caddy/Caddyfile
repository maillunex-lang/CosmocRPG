{
	admin off
	auto_https disable_redirects
	# клиенты, подключающиеся по IP, не присылают SNI
	default_sni {$PUBLIC_HOST}
}

# Общие правила для всех адресов
(common) {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	# Админ-API Go-сервера (внутренняя сеть, наружу не публикуется); префикс /admin отбрасывается
	handle /admin/api/* {
		uri strip_prefix /admin
		reverse_proxy server:8081
	}

	# Статика админки (SPA: неизвестные пути отдают index.html)
	handle /admin/* {
		uri strip_prefix /admin
		root * /srv
		try_files {path} /index.html
		file_server
	}

	redir /admin /admin/ permanent
}

# Игра и админка на домене: настоящий сертификат Let's Encrypt (проверка TLS-ALPN на порту 443, порт 80 не нужен).
# Игровой WebSocket: wss://<домен>/ws
{$GAME_DOMAIN:rikagro.ru}, www.{$GAME_DOMAIN:rikagro.ru} {
	import common

	handle /ws {
		reverse_proxy server:8080
	}
	handle /health {
		reverse_proxy server:8080
	}
	# Подписанные ресурсы дизайна (R-53): манифест и файлы по сумме отдаёт Go-сервер, подпись проверяет клиент
	handle /assets/* {
		reverse_proxy server:8080
	}
	# Библиотека музыки (R-37): только чтение. Загрузка — через админ-API, файлы на томе сервера.
	handle /media/* {
		reverse_proxy server:8080
	}
	# Раздача APK по HTTPS: https://<домен>/download/<файл>.apk (каталог монтируется только на чтение, без списка файлов)
	handle /download/* {
		uri strip_prefix /download
		root * /downloads
		@pkg path *.apk
		header @pkg Content-Type application/vnd.android.package-archive
		header @pkg Content-Disposition attachment
		@json path *.json
		header @json Content-Type "application/json; charset=utf-8"
		header @json Cache-Control "no-store"
		@sig path *.sig
		header @sig Cache-Control "no-store"
		file_server
	}
	# Лендинг на корне домена (решение владельца R-39): статические файлы из образа (/site), без внешних скриптов
	handle {
		root * /site
		file_server
	}
}

# Админка: https://<хост>/admin/ , HTTPS с самоподписанным сертификатом (внутренний CA Caddy), домена пока нет.
https://{$PUBLIC_HOST}, https://localhost, https://127.0.0.1 {
	tls internal
	import common

	# Всё остальное, включая корень, ведёт в админку
	handle {
		redir * /admin/ temporary
	}
}
