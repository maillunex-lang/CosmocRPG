{
  "type": "object",
  "properties": {
    "schema": {
      "const": "AI_Civilization_Pack_v1"
    },
    "schema_version": {
      "const": 1
    },
    "pack_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_\\-]+$"
    },
    "kind": {
      "enum": [
        "full",
        "partial"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 10,
      "maxLength": 40
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "base_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "batch": {
      "type": [
        "object",
        "null"
      ]
    },
    "captains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 8,
        "pattern": "^cpt-\\d{4}$"
      },
      "minItems": 0,
      "maxItems": 400,
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 800
    },
    "notes": {
      "type": "string",
      "minLength": 0,
      "maxLength": 2000
    }
  },
  "required": [
    "schema",
    "schema_version",
    "pack_id",
    "kind",
    "created_at",
    "captains",
    "files"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Манифест пакета AI_Civilization_Pack_v1"
}
